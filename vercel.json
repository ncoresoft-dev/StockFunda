{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd StockLens_Frontend && npm install && npm run build",
  "outputDirectory": "StockLens_Frontend/dist/StockLens_Frontend",
  "headers": [
    {
      "source": "/(.*)\\.(js|css|ico|png|jpg|jpeg|svg|webp|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
